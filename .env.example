# FINAI Environment Configuration Example

# Server Configuration
PORT=5000
NODE_ENV=development

# Security / Authentication
JWT_SECRET=finai_super_secret_jwt_key_change_in_production_2026
JWT_EXPIRES_IN=7d

# -------------------------------------------------------------
# FREE AI MODELS (No credit card required!)
# -------------------------------------------------------------
# Option 1: Google Gemini API (Recommended - 100% Free)
# Get key in 30 seconds at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Option 2: Groq Cloud API (Ultra-fast Llama 3.3 - 100% Free)
# Get key in 30 seconds at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Option 3: Anthropic Claude API
# https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# -------------------------------------------------------------
# Google Sheets Integration
# -------------------------------------------------------------
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/your_deployment_id/exec
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# CORS Origin
CORS_ORIGIN=*
